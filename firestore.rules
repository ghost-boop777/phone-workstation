rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Founders: hardcoded root admins, always allowed (safe even before any config doc exists).
    function isFounder() {
      return request.auth != null && request.auth.token.email in [
        'helloleads2@gmail.com',
        'thalableedblue@gmail.com'
      ];
    }
    function cfgExists() { return exists(/databases/$(database)/documents/config/allowlist); }
    function inAllowlist() {
      return cfgExists() && request.auth.token.email in get(/databases/$(database)/documents/config/allowlist).data.emails;
    }
    // Allowed = a founder, OR a signed-in user added to the self-serve allowlist.
    function allowed() { return isFounder() || (request.auth != null && inAllowlist()); }

    // Self-serve allowlist: any signed-in user may READ it (to check themselves on login);
    // only founders may EDIT it.
    match /config/allowlist {
      allow read:  if request.auth != null;
      allow write: if isFounder();
    }

    // Race-safe packet number counter — incremented in a transaction.
    match /config/packet_counter {
      allow read, write: if allowed();
    }

    // Per-client DNC-Sent lists (numbers already sent to a given client),
    // sharded into documents of arrays tagged with { client }.
    match /dnc/{doc} {
      allow read, write: if allowed();
    }

    // Recipient/client roster used by the DNC-Sent dropdown.
    match /config/clients {
      allow read, write: if allowed();
    }

    // Legacy master list (kept readable so old data can be cleaned up).
    match /master/{doc} {
      allow read, write: if allowed();
    }

    // Shared batch history (one doc per saved batch: counts, scrub).
    match /batches/{doc} {
      allow read, write: if allowed();
    }

    // Lead Bank packet index (metadata only; the lead files live in Google Drive).
    match /packets/{doc} {
      allow read, write: if allowed();
    }

    // Source-upload index (metadata only; the original raw files live in Google Drive).
    match /uploads/{doc} {
      allow read, write: if allowed();
    }

    // Saved-dataset index (metadata only; the dataset JSON files live in Google Drive).
    match /datasets/{doc} {
      allow read, write: if allowed();
    }

    // First-party consent-capture leads. ANYONE may CREATE a lead (the public
    // signup form is unauthenticated), but only allowlisted staff may read/edit/
    // delete. Creates are shape-validated to blunt spam/abuse: consent must be
    // true, only the expected keys, bounded string sizes, server timestamp.
    match /leads/{doc} {
      allow read, update, delete: if allowed();
      allow create: if validLead(request.resource.data);
    }
    function validLead(d) {
      return d.consent == true
        && d.keys().hasOnly(['firstName','lastName','phone','email','address','town','postcode','consent','marketingConsent','consentText','consentVersion','service','device','issue','urgency','source','userAgent','at'])
        && d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 80
        && d.lastName is string && d.lastName.size() <= 80
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 30
        && d.email is string && d.email.size() <= 120
        && d.address is string && d.address.size() <= 200
        && d.town is string && d.town.size() <= 80
        && d.postcode is string && d.postcode.size() <= 12
        && d.consentText is string && d.consentText.size() > 0 && d.consentText.size() <= 600
        && d.consentVersion is string && d.consentVersion.size() <= 40
        && d.source is string && d.source.size() <= 60
        && d.userAgent is string && d.userAgent.size() <= 300
        && d.get('marketingConsent', false) is bool
        && d.get('service', '') is string && d.get('service', '').size() <= 80
        && d.get('device', '') is string && d.get('device', '').size() <= 80
        && d.get('issue', '') is string && d.get('issue', '').size() <= 500
        && d.get('urgency', '') is string && d.get('urgency', '').size() <= 40
        && d.at == request.time;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
